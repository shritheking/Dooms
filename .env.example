# ==============================================================================
# Avengers: Doomsday Booking Alert Bot — Environment Configuration (Telegram Only)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram Bot API Credentials
# ------------------------------------------------------------------------------
# Obtain your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Your personal or group Telegram Chat ID (e.g. 5188160752)
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 2. Target Cinema & Movie Configuration
# ------------------------------------------------------------------------------
MOVIE_TITLE=Avengers: Doomsday
CINEMA_NAME=Ritzy Sha Cinemas
CINEMA_CODE=RZYM
LOCATION_CITY=Madurai
LOCATION_STATE=Tamil Nadu, India

# BookMyShow Venue URL for Ritzy Sha Cinemas Madurai
BMS_VENUE_URL=https://in.bookmyshow.com/cinemas/madurai/ritzy-sha-cinemas-4k-rgb-laser-atmos-madurai/buytickets/RZYM

# ------------------------------------------------------------------------------
# 3. Monitoring & Scheduler Settings
# ------------------------------------------------------------------------------
# Monitoring check interval in seconds (300 seconds = 5 minutes)
CHECK_INTERVAL_SECONDS=300
# Horizon of upcoming days to monitor (e.g. next 14 days)
MONITORING_HORIZON_DAYS=14
# Headless browser mode (true for background service, false for visible browser debugging)
HEADLESS_BROWSER=true

# ------------------------------------------------------------------------------
# 4. Dashboard & Networking
# ------------------------------------------------------------------------------
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DATABASE_NAME=booking_bot.sqlite
LOG_LEVEL=INFO

# Optional proxy for bypassing cloud IP restrictions (e.g. http://username:password@proxyhost:port)
# Leave blank to use direct connection
BMS_PROXY=
